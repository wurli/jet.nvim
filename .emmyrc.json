{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "disable": [
      "unnecessary-if"
    ]
  },
  "runtime": {
    "requirePattern": [
      "?/init.lua",
      "?.lua"
    ],
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreDir": [
      "deps",
	  ".venv"
    ],
    "ignoreGlobs": [
      "*.log"
    ],
    "library": [
      "$VIMRUNTIME",
      "./deps",
      "$HOME/.local/share/nvim/lazy/image.nvim/",
      "$HOME/.local/share/nvim/lazy/snacks.nvim/",
      "$HOME/.local/share/nvim/lazy/lualine.nvim/"
    ],
	"workspaceRoots": [
		"./lua"
	]
  }
}
