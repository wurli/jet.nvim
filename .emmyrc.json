{
  "diagnostics": {
    "disable": [
      "unnecessary-if"
    ]
  },
  "runtime": {
    "requirePattern": [
      "?/init.lua",
      "?.lua"
    ],
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreDir": [
      "deps"
    ],
    "ignoreGlobs": [
      "*.log"
    ],
    "library": [
      "$VIMRUNTIME",
      "./deps",
      "$HOME/.local/share/nvim/lazy/snacks.nvim/"
    ]
  }
}
